{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Tests with Clang",
      "type": "shell",
      "command": "clang++",
      "args": [
        "-o",
        "${workspaceFolder}/build_debug/test",
        "${workspaceFolder}/test.cpp",
        "-fopenmp",
        "-fsanitize=address",
        "-fsanitize=undefined",
        "-g",
        "-O0",
        "--std=c++20"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Compiles the CPU kernel tests using Clang"
    },
    {
      "label": "Compile Tests with AppleClang",
      "type": "shell",
      "command": "clang++",
      "args": [
        "-o",
        "${workspaceFolder}/build_debug/test",
        "${workspaceFolder}/test.cpp",
        "-fsanitize=address",
        "-fsanitize=undefined",
        "-g",
        "-O0",
        "--std=c++20"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Compiles the CPU kernel tests using AppleClang"
    }
  ]
}
